# 复制为 python/.env 并填写真实值 —— .env 已被 .gitignore 排除, 凭据永不入库
# 切换 MySQL: 填好下面各项后设置 APR_DB_BACKEND=mysql, 再执行
#   python python/scripts/migrate_to_mysql.py   (存量数据迁移)
APR_DB_BACKEND=mysql
APR_MYSQL_HOST=127.0.0.1
APR_MYSQL_PORT=3306
APR_MYSQL_USER=root
APR_MYSQL_PWD=请填写root密码
APR_MYSQL_DB=agri_price_radar
